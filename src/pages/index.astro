---
import Layout from "../layouts/Layout.astro";

const services = [
  {
    title: "Shoe & Boot Repair",
    desc: "Resoling, heel replacement, stitching, and restoration for everything from work boots to designer heels.",
    img: "/photos/cowboy-boot-resole.jpg",
  },
  {
    title: "Leather Repair",
    desc: "Belts, bags, jackets, and other leather goods given a longer, stronger life.",
    img: "/photos/belts-stack.jpg",
  },
  {
    title: "Custom Leather Work",
    desc: "Hand-stitched sheaths, straps, and bespoke pieces made to order.",
    img: "/photos/knife-sheath.jpg",
  },
];
---

<Layout>
  <section class="relative min-h-[85vh] flex items-end overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/photos/landis-machines.jpg');"
    >
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/40 to-ink/20"></div>
    <div class="relative max-w-6xl mx-auto px-6 pb-20 md:pb-28 text-cream">
      <p class="text-xs md:text-sm uppercase tracking-[0.3em] text-tan mb-6">
        Ansley Travo · Cobbler · Zumbrota, MN
      </p>
      <h1 class="font-display text-5xl md:text-7xl leading-[1.05] max-w-3xl mb-6">
        Shoes are the roots of your body.
      </h1>
      <p class="font-serif italic text-lg md:text-xl text-cream/85 max-w-xl mb-10">
        Quality repairs, honest service, and workmanship you can trust — for the
        items you love most.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="/services"
          class="px-7 py-3 bg-oxblood text-cream text-sm uppercase tracking-widest hover:bg-oxblood-dark transition-colors"
        >
          See Our Work
        </a>
        <a
          href="/contact"
          class="px-7 py-3 border border-cream/40 text-cream text-sm uppercase tracking-widest hover:bg-cream/10 transition-colors"
        >
          Request a Repair
        </a>
      </div>
    </div>
  </section>

  <section class="py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-xs uppercase tracking-[0.3em] text-tan mb-6">Our Story</p>
      <h2 class="font-display text-4xl md:text-5xl mb-8 leading-tight">
        A craft passed hand to hand.
      </h2>
      <p class="font-serif text-lg md:text-xl text-ink-soft leading-relaxed mb-8">
        It started at fifteen, sweeping floors at Luya Shoes in Zumbrota. What
        began as a job became a calling — shaped by mentors like Connie Hawley
        and Mike Derouin, and grounded in the belief that a good pair of
        footwear changes how you move through the world.
      </p>
      <a
        href="/about"
        class="inline-block text-sm uppercase tracking-widest text-oxblood border-b border-oxblood/40 hover:border-oxblood pb-1 transition-colors"
      >
        Read Ansley's Story
      </a>
    </div>
  </section>

  <section class="bg-cream py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-xs uppercase tracking-[0.3em] text-tan mb-4">What We Do</p>
        <h2 class="font-display text-4xl md:text-5xl">Services</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-10">
        {
          services.map((service) => (
            <div class="group">
              <div class="aspect-[4/5] overflow-hidden bg-cream-dark mb-5">
                <img
                  src={service.img}
                  alt={service.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />
              </div>
              <h3 class="font-display text-2xl mb-2">{service.title}</h3>
              <p class="text-ink-soft leading-relaxed">{service.desc}</p>
            </div>
          ))
        }
      </div>
      <div class="text-center mt-14">
        <a
          href="/services"
          class="inline-block px-7 py-3 border border-ink/30 text-ink text-sm uppercase tracking-widest hover:bg-ink hover:text-cream transition-colors"
        >
          All Services
        </a>
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-ink text-cream">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-xs uppercase tracking-[0.3em] text-tan mb-6">Visit</p>
      <h2 class="font-display text-4xl md:text-5xl mb-8">Drop Off at Luya Shoes</h2>
      <p class="text-lg text-cream/80 mb-2">236 S Main St, Zumbrota, MN</p>
      <p class="text-lg text-cream/80 mb-10">
        <a href="tel:5078840768" class="hover:text-cream">507-884-0768</a>
      </p>
      <a
        href="/contact"
        class="inline-block px-7 py-3 bg-oxblood text-cream text-sm uppercase tracking-widest hover:bg-oxblood-dark transition-colors"
      >
        Get in Touch
      </a>
    </div>
  </section>
</Layout>
