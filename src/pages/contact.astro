---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact — Zumbrota Shoe & Leather Repair"
  description="Drop off at Luya Shoes, 236 S Main St, Zumbrota, MN. Call 507-884-0768 or email cobblersbenchzm@gmail.com."
>
  <section class="bg-cream py-20 px-6 border-b border-cream-dark">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-xs uppercase tracking-[0.3em] text-tan mb-6">Contact</p>
      <h1 class="font-display text-5xl md:text-6xl mb-6">Bring it in.</h1>
      <p class="font-serif text-lg md:text-xl text-ink-soft leading-relaxed max-w-2xl mx-auto">
        Drop off your repair at Luya Shoes on Main Street, or send a message
        below for a quote.
      </p>
    </div>
  </section>

  <section class="py-20 px-6">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16">
      <div>
        <img
          src="/photos/luya-storefront.jpg"
          alt="Luya Shoes storefront on Main Street, Zumbrota"
          class="w-full aspect-[4/5] object-cover mb-6"
        />
        <div class="space-y-8">
          <div>
            <h3 class="text-xs uppercase tracking-[0.3em] text-tan mb-3">Drop Off</h3>
            <p class="font-display text-2xl text-ink mb-1">Luya Shoes</p>
            <p class="text-ink-soft">236 S Main St<br />Zumbrota, MN</p>
          </div>
          <div>
            <h3 class="text-xs uppercase tracking-[0.3em] text-tan mb-3">Phone</h3>
            <a href="tel:5078840768" class="font-display text-2xl text-ink hover:text-oxblood">
              507-884-0768
            </a>
          </div>
          <div>
            <h3 class="text-xs uppercase tracking-[0.3em] text-tan mb-3">Email</h3>
            <a
              href="mailto:cobblersbenchzm@gmail.com"
              class="font-display text-xl text-ink hover:text-oxblood break-all"
            >
              cobblersbenchzm@gmail.com
            </a>
          </div>
        </div>
      </div>

      <div>
        <h2 class="font-display text-3xl mb-2">Send a message</h2>
        <p class="text-ink-soft mb-8">
          Describe what you need repaired and I'll get back to you with a quote.
        </p>
        <form
          action="https://formspree.io/f/REPLACE_WITH_FORMSPREE_ID"
          method="POST"
          class="space-y-5"
        >
          <div>
            <label for="name" class="block text-xs uppercase tracking-widest text-ink-soft mb-2">
              Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 bg-cream border border-cream-dark focus:border-oxblood focus:outline-none transition-colors"
            />
          </div>
          <div>
            <label for="email" class="block text-xs uppercase tracking-widest text-ink-soft mb-2">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 bg-cream border border-cream-dark focus:border-oxblood focus:outline-none transition-colors"
            />
          </div>
          <div>
            <label for="phone" class="block text-xs uppercase tracking-widest text-ink-soft mb-2">
              Phone (optional)
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full px-4 py-3 bg-cream border border-cream-dark focus:border-oxblood focus:outline-none transition-colors"
            />
          </div>
          <div>
            <label for="message" class="block text-xs uppercase tracking-widest text-ink-soft mb-2">
              What needs repair?
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              class="w-full px-4 py-3 bg-cream border border-cream-dark focus:border-oxblood focus:outline-none transition-colors resize-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full px-7 py-4 bg-oxblood text-cream text-sm uppercase tracking-widest hover:bg-oxblood-dark transition-colors"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>
