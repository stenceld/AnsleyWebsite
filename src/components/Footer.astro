---
const year = new Date().getFullYear();
---

<footer class="bg-ink text-cream mt-24">
  <div class="max-w-6xl mx-auto px-6 py-16 grid md:grid-cols-3 gap-12">
    <div>
      <h3 class="font-display text-2xl mb-3">Zumbrota Shoe & Leather Repair</h3>
      <p class="text-sm text-cream/70 leading-relaxed">
        Quality repairs, honest service, and workmanship you can trust.
      </p>
    </div>
    <div>
      <h4 class="text-xs uppercase tracking-widest text-tan mb-4">Visit</h4>
      <p class="text-sm leading-relaxed text-cream/85">
        Drop off at Luya Shoes<br />
        236 S Main St<br />
        Zumbrota, MN
      </p>
    </div>
    <div>
      <h4 class="text-xs uppercase tracking-widest text-tan mb-4">Contact</h4>
      <p class="text-sm leading-relaxed text-cream/85">
        <a href="tel:5078840768" class="hover:text-cream">507-884-0768</a><br />
        <a href="mailto:cobblersbenchzm@gmail.com" class="hover:text-cream">cobblersbenchzm@gmail.com</a>
      </p>
    </div>
  </div>
  <div class="border-t border-cream/10">
    <div class="max-w-6xl mx-auto px-6 py-6 text-xs text-cream/50 flex flex-col md:flex-row gap-2 justify-between">
      <span>© {year} Ansley Travo · Zumbrota Shoe & Leather Repair</span>
      <span>Zumbrota, Minnesota</span>
    </div>
  </div>
</footer>
